# Virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/

# Model weights and caches
models/weights/
*.pth
*.pt
*.safetensors
.cache/

# Internal progress tracking
PROGRESS_LOG.txt

# Personal photos (see data/samples/README.md). The annotated results of the real pairs and the
# source outdoor photos are never versioned. The 3 real validation pairs (real_before*/real_after*,
# .jpg) ARE versioned through the negation below.
# Warning: any new .jpg photo matching real_before*/real_after* becomes visible to git; for a new
# personal pair use another prefix or add it to .git/info/exclude.
# Specific prefixes only: real_pairs.json and no_interior_01.png stay versioned.
data/samples/real_before*
data/samples/real_after*
data/samples/real_comparison_output*
data/samples/exterior*
# Exception: the real test pairs are versioned (without GPS data) so the integration tests run anywhere.
!data/samples/real_before*.jpg
!data/samples/real_after*.jpg

# IDE and OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
